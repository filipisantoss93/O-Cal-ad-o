# Projeto Supabase exclusivo do O Calçadão
NEXT_PUBLIC_SUPABASE_URL=https://mieekhdagjlzdbeklrxp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_PELA_CHAVE_PUBLICAVEL

# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Endpoint Nominatim compatível usado somente quando o GPS não estiver disponível.
# Pode apontar para outra instância compatível sem alterar o aplicativo.
GEOCODING_API_URL=https://nominatim.openstreetmap.org/search

# Google Places API (New) — somente no servidor, nunca use NEXT_PUBLIC_.
# É necessária uma chave própria vinculada a um projeto Google Cloud com faturamento.
# A consulta interna pode identificar o Place ID; NÃO use coordenadas do Google para
# construir um catálogo permanente compartilhado (limite de retenção aplicável).
GOOGLE_PLACES_API_KEY=SUBSTITUA_PELA_CHAVE_DO_GOOGLE_CLOUD
# Rating e userRatingCount usam Place Details Enterprise. Desativados por padrão:
# somente habilitar após definir cotas, controle de requisições e orçamento no Google Cloud.
GOOGLE_RATINGS_ENABLED=false

# Efí Bank
# As credenciais NÃO ficam na Vercel nem neste arquivo.
# Configure em Supabase Dashboard > Edge Functions > Secrets:
# EFI_CLIENT_ID
# EFI_CLIENT_SECRET
# EFI_CHARGES_SANDBOX=false   # produção

# Planejamento de rotas para eletropostos (chave exclusiva do servidor).
# Crie uma chave openrouteservice e configure também na Vercel (produção/preview).
# Sem a chave, a busca de eletropostos próximos continua funcionando;
# a rota rodoviária dentro do Calçadão exibe aviso de indisponibilidade.
OPENROUTESERVICE_API_KEY=
